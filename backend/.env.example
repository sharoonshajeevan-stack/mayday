# MAYDAY OS API Configuration
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=5000
API_HOST=0.0.0.0

# Local AI (offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Online AI (Gemini)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Voice mode: offline | online | auto
# offline = Faster-Whisper + Ollama + Kokoro   (no internet needed)
# online  = online STT/AI/TTS APIs
# auto    = online when an API key is configured, otherwise offline
MAYDAY_VOICE_MODE=auto

# Warm up the local voice models on server start (true | false)
MAYDAY_PRELOAD_VOICE=true

# --- Offline speech-to-text (Faster-Whisper) --------------------------------
# Model sizes: tiny | base | small | medium | large-v3  (bigger = more accurate
# but slower). On a CPU-only laptop, "base" or "small" is a good balance.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

# Microphone capture tuning
STT_SILENCE_THRESHOLD=0.012
STT_MIN_SECONDS=0.6
STT_MAX_SECONDS=30
STT_SILENCE_SECONDS=1.4

# --- Offline text-to-speech (Kokoro-82M) ------------------------------------
# Voice IDs are verified against the model repository at runtime. Some warm,
# expressive female options: bf_emma, bf_alice, bf_isabella (British) and
# af_heart, af_bella, af_nicole (American). The voice prefix selects the accent
# ('b' = British English, 'a' = American English).
KOKORO_VOICE=bf_emma
KOKORO_LANG=b
KOKORO_DEVICE=cpu
KOKORO_SPEED=1.0
KOKORO_CHUNK_CHARS=160
# The first spoken piece is kept short so audio starts quickly.
KOKORO_FIRST_CHARS=30
# Loudness: normalize each chunk to this peak (0-1) and optionally add gain.
KOKORO_TARGET_PEAK=0.97
KOKORO_GAIN=1.0

# --- Online voice APIs (optional) -------------------------------------------
# Replace the placeholder with your real API key.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TIMEOUT=120

# --- Real-time voice (Pipecat) ----------------------------------------------
# The real-time voice service runs as a separate local process that drives the
# machine's own microphone and speakers (transport=local). It is bound to
# localhost only and is started on demand from the HUD.
MAYDAY_VOICE_HOST=127.0.0.1
MAYDAY_VOICE_PORT=7860
# Optional shared token: when set, the control WebSocket requires ?token=...
MAYDAY_VOICE_TOKEN=
# Start listening as soon as the service boots (keep false for privacy).
MAYDAY_VOICE_AUTOSTART=false
MAYDAY_VOICE_LOG_LEVEL=INFO

# Voice-activity detection. Raise confidence / min_volume to make MAYDAY less
# sensitive to background noise; lower them for a quieter room.
MAYDAY_VAD_CONFIDENCE=0.6
MAYDAY_VAD_START_SECS=0.2
MAYDAY_VAD_STOP_SECS=0.8
MAYDAY_VAD_MIN_VOLUME=0.6

# How long to wait after the user stops before forcing the turn closed.
MAYDAY_USER_TURN_STOP_TIMEOUT=4.0
# Extra silence kept after speech stops when transcribing a segment.
MAYDAY_STT_TRAILING_SILENCE=0.4
