# MAYDAY OS API Configuration
FLASK_ENV=development
FLASK_DEBUG=True
API_PORT=5000
API_HOST=0.0.0.0

# Local AI (offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Online AI (Gemini)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Voice mode: offline | online | auto
# offline = Faster-Whisper + Ollama + Kokoro   (no internet needed)
# online  = online STT/AI/TTS APIs
# auto    = online when an API key is configured, otherwise offline
MAYDAY_VOICE_MODE=auto

# Warm up the local voice models on server start (true | false)
MAYDAY_PRELOAD_VOICE=true

# --- Offline speech-to-text (Faster-Whisper) --------------------------------
# Model sizes: tiny | base | small | medium | large-v3  (bigger = more accurate
# but slower). On a CPU-only laptop, "base" or "small" is a good balance.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

# Microphone capture tuning
STT_SILENCE_THRESHOLD=0.012
STT_MIN_SECONDS=0.6
STT_MAX_SECONDS=30
STT_SILENCE_SECONDS=1.4

# --- Offline text-to-speech (Kokoro-82M) ------------------------------------
# Voice IDs are verified against the model repository at runtime. Some warm,
# expressive female options: af_heart, af_bella, af_nicole, bf_emma.
KOKORO_VOICE=af_heart
KOKORO_LANG=a
KOKORO_DEVICE=cpu
KOKORO_SPEED=1.0
KOKORO_CHUNK_CHARS=160
# The first spoken piece is kept short so audio starts quickly.
KOKORO_FIRST_CHARS=30
# Loudness: normalize each chunk to this peak (0-1) and optionally add gain.
KOKORO_TARGET_PEAK=0.97
KOKORO_GAIN=1.0

# --- Online voice APIs (optional) -------------------------------------------
# Replace the placeholder with your real API key.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TIMEOUT=120
